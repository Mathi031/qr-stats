# ---- qr-api (Go) ----
PORT=8080
STATS_API_URL=http://localhost:3000

# Auth: clientes externos obtienen un JWT en POST /api/v1/token y lo envían como
# Authorization: Bearer <token> en POST /api/v1/qr.
JWT_SECRET=dev-secret-change-me
AUTH_USERNAME=admin
AUTH_PASSWORD=admin

# Secreto compartido qr-api -> stats-api (header X-Internal-Key).
# DEBE coincidir con el INTERNAL_API_KEY de stats-api.
INTERNAL_API_KEY=dev-internal-key-change-me

# Origen(es) permitido(s) por CORS para el frontend en el navegador. "*" para
# desarrollo; en producción restríngelo a la URL del frontend
# (p. ej. https://qr-frontend.onrender.com).
CORS_ORIGIN=*

# ---- stats-api (Node) ----
# PORT=3000
# Mismo valor que el INTERNAL_API_KEY de qr-api.
# INTERNAL_API_KEY=dev-internal-key-change-me
